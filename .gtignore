# Environment variables
.env
.env.local
.env.*.local

# IDE and Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# PHP
vendor/
composer.lock
.php_cs.cache

# Node (if using npm)
node_modules/
npm-debug.log
yarn-error.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Uploads
assets/uploads/workers/*
assets/uploads/faces/*
!assets/uploads/.gitkeep

# Logs
logs/*.log
logs/*.txt
!logs/.gitkeep

# Cache
cache/*
!cache/.gitkeep

# Backups
backups/*
!backups/.gitkeep

# Exports
exports/*
!exports/.gitkeep

# Temporary files
temp/
tmp/
*.tmp
*.bak
*.backup

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# Database
*.sql.bak
*.sql.backup
database_backup.sql

# Configuration (local)
config.local.php
database.local.php

# Testing
.phpunit.result.cache
coverage/

# Build
dist/
build/

# Documentation (generated)
docs/generated/
api-docs/

# Sensitive files
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# Node/npm (if applicable)
package-lock.json
yarn.lock

# Misc
.env.example.local
.htaccess.bak
robots.txt.bak