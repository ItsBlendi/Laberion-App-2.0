# =====================================================
# Laberion WMS - Environment Configuration
# =====================================================

# =====================================================
# APPLICATION SETTINGS
# =====================================================

APP_NAME=Laberion WMS
APP_VERSION=1.0.0
APP_URL=http://localhost/laberion
APP_ENV=development
APP_DEBUG=false
APP_TIMEZONE=Europe/Zurich

# =====================================================
# DATABASE CONFIGURATION
# =====================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=laberion_wms
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Connection pool settings
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=30

# =====================================================
# SECURITY SETTINGS
# =====================================================

# Session
SESSION_LIFETIME=3600
SESSION_TIMEOUT=1800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# CSRF Protection
CSRF_PROTECTION=true
CSRF_TOKEN_LENGTH=32

# Password
PASSWORD_MIN_LENGTH=6
PASSWORD_HASH_ALGO=bcrypt
PASSWORD_HASH_COST=10

# Login
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_TIMEOUT=900

# =====================================================
# FACE RECOGNITION SETTINGS
# =====================================================

PYTHON_PATH=/usr/bin/python3
FACE_RECOGNITION_THRESHOLD=0.6
FACE_RECOGNITION_TIMEOUT=30
FACE_RECOGNITION_MODEL=hog

# Model paths
FACE_MODEL_PATH=./python/models/
FACE_ENCODINGS_FILE=./python/models/face_encodings.pkl
CASCADE_CLASSIFIER=./python/models/haarcascade_frontalface_default.xml

# =====================================================
# FILE UPLOAD SETTINGS
# =====================================================

UPLOAD_DIR=./assets/uploads
UPLOAD_WORKERS_DIR=./assets/uploads/workers
UPLOAD_FACES_DIR=./assets/uploads/faces
UPLOAD_EXPORTS_DIR=./exports

MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# Image settings
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
IMAGE_QUALITY=85

# =====================================================
# WORKING HOURS SETTINGS
# =====================================================

WORK_START_TIME=09:00:00
WORK_END_TIME=17:00:00
LATE_THRESHOLD=15
WORK_DAYS=Monday,Tuesday,Wednesday,Thursday,Friday

# =====================================================
# EMAIL SETTINGS
# =====================================================

MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@laberion.com
MAIL_FROM_NAME=Laberion WMS

# Alternative: Using sendmail
# MAIL_DRIVER=sendmail
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -t -i

# =====================================================
# LOGGING SETTINGS
# =====================================================

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_ERRORS=true
LOG_ACTIVITIES=true
LOG_ATTENDANCE=true
LOG_MAX_FILES=30

# =====================================================
# CACHE SETTINGS
# =====================================================

CACHE_DRIVER=file
CACHE_DIR=./cache
CACHE_LIFETIME=3600

# =====================================================
# PAGINATION SETTINGS
# =====================================================

ITEMS_PER_PAGE=15
ITEMS_PER_PAGE_SMALL=10
ITEMS_PER_PAGE_LARGE=50

# =====================================================
# API SETTINGS
# =====================================================

API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
API_TIMEOUT=30
API_RESPONSE_FORMAT=json

# =====================================================
# BACKUP SETTINGS
# =====================================================

BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true

# =====================================================
# NOTIFICATION SETTINGS
# =====================================================

ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false

# SMS Gateway (Twilio)
SMS_DRIVER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =====================================================
# EXTERNAL SERVICES
# =====================================================

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=

# Sentry (error tracking)
SENTRY_DSN=

# Analytics
GOOGLE_ANALYTICS_ID=

# =====================================================
# DEVELOPMENT SETTINGS
# =====================================================

# Debug mode
DEBUG_MODE=false
DEBUG_SQL=false
DEBUG_PERFORMANCE=false

# Development server
DEV_SERVER_HOST=localhost
DEV_SERVER_PORT=8000

# =====================================================
# PRODUCTION SETTINGS
# =====================================================

# SSL/TLS
FORCE_HTTPS=false
SSL_CERT_PATH=/etc/ssl/certs/laberion.crt
SSL_KEY_PATH=/etc/ssl/private/laberion.key

# Domain
DOMAIN=laberion.com
ALLOWED_DOMAINS=laberion.com,www.laberion.com

# =====================================================
# FEATURE FLAGS
# =====================================================

FEATURE_FACE_RECOGNITION=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_REPORTS=true
FEATURE_EXPORTS=true
FEATURE_BULK_IMPORT=true

# =====================================================
# MAINTENANCE MODE
# =====================================================

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.

# =====================================================
# RATE LIMITING
# =====================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# =====================================================
# SECURITY KEYS
# =====================================================

# Generate with: openssl rand -base64 32
APP_KEY=your_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here

# =====================================================
# THIRD PARTY INTEGRATIONS
# =====================================================

# Slack
SLACK_WEBHOOK_URL=

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# =====================================================
# MONITORING & ALERTS
# =====================================================

MONITORING_ENABLED=false
ALERT_EMAIL=admin@laberion.com
ALERT_THRESHOLD_CPU=80
ALERT_THRESHOLD_MEMORY=85
ALERT_THRESHOLD_DISK=90

# =====================================================
# CUSTOM SETTINGS
# =====================================================

# Add any custom settings here
COMPANY_NAME=Your Company Name
COMPANY_LOGO=./assets/images/logo.png
COMPANY_ADDRESS=123 Main St, City, Country
COMPANY_PHONE=+1 (555) 123-4567
COMPANY_EMAIL=info@company.com

# =====================================================
# END OF CONFIGURATION
# =====================================================