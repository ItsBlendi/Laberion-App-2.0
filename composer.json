{
    "name": "laberion/wms",
    "description": "Laberion Workforce Management System",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Laberion Team",
            "email": "dev@laberion.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-mysqli": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Laberion\\": "src/"
        },
        "files": [
            "includes/functions.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyze": "phpstan analyse"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}